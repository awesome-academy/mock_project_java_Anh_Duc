# Database Configuration
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control

# Database Name
DB_NAME=

# Database URL (format: jdbc:mysql://host:port/database_name)
# For local development (without Docker): jdbc:mysql://localhost:3306/booking_tours
# For Docker: This will be set automatically in docker-compose.yml
DB_URL=

# Database Username
DB_USERNAME=

# Database Password
DB_PASSWORD=

# MySQL Root Password (for Docker)
DB_ROOT_PASSWORD=

# Database Port
DB_PORT=

# Email Configuration
# For Gmail: Use App Password (not your regular password)
# See: https://myaccount.google.com/apppasswords
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_FROM=your-email@gmail.com

# Application Configuration
# Base URL of your application (used in verification emails)
APP_BASE_URL=http://localhost:8080

# Verification token expiry time in hours (default: 24)
VERIFICATION_TOKEN_EXPIRY=24

# JWT Configuration
JWT_SECRET_KEY=
JWT_EXPIRATION=86400000
