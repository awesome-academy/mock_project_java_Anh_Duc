# Database Configuration
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control

# Database Name
DB_NAME=

# Database URL (format: jdbc:mysql://host:port/database_name)
# For local development (without Docker): jdbc:mysql://localhost:3306/booking_tours
# For Docker: This will be set automatically in docker-compose.yml
DB_URL=

# Database Username
DB_USERNAME=

# Database Password
DB_PASSWORD=

# MySQL Root Password (for Docker)
DB_ROOT_PASSWORD=

# Database Port
DB_PORT=
